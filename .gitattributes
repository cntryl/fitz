
# Normalize line endings for text files.
* text=auto eol=lf

# Common source and config formats.
*.rs text
*.toml text
*.md text
*.markdown text
*.txt text
*.json text
*.yml text
*.yaml text
*.html text
*.css text
*.scss text
*.js text
*.ts text
*.tsx text
*.jsx text
*.py text
*.ps1 text
*.sh text

# Binary assets and archives.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.lib binary
*.a binary

# Keep generated build output out of archives and language statistics.
/target/** export-ignore linguist-vendored
/.cargo/** export-ignore linguist-vendored
/.vscode/** export-ignore
/.idea/** export-ignore

# Ensure this file is tracked as text.
.gitattributes text

