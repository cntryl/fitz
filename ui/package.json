{
  "name": "fitz-ui",
  "type": "module",
  "scripts": {
    "clean": "npx rimraf node_modules dist",
    "dev": "vp dev",
    "dev:mock": "VITE_FITZ_MOCK_API=1 vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:preview": "npm run build && PLAYWRIGHT_PREVIEW=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "check:generated": "askr generate ../public/openapi.yml -o ./src/adapters/generated --check",
    "type-check": "tsc --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "gen": "npm run gen:adapters && npm run fmt",
    "gen:adapters": "askr generate ../public/openapi.yml -o ./src/adapters/generated"
  },
  "dependencies": {
    "@askrjs/askr": "^0.5.1",
    "@askrjs/auth": "^0.5.1",
    "@askrjs/fetch": "0.5.0",
    "@askrjs/lucide": "0.5.1",
    "@askrjs/themes": "^0.5.1",
    "@askrjs/ui": "^0.5.0"
  },
  "devDependencies": {
    "@askrjs/cli": "0.5.1",
    "@askrjs/vite": "0.5.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "@vitest/browser-playwright": "5.1.0",
    "@xmldom/xmldom": "0.9.12",
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "vite": "$vite",
    "vitest": "5.1.0"
  },
  "packageManager": "npm@12.2.3",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "askr": {
    "update": {
      "ignore": [
        "vite-plus"
      ]
    }
  }
}
