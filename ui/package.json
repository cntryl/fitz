{
  "name": "fitz-admin-ui",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "fmt": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.md\"",
    "gen:adapters": "npx @fgrzl/fetch-gen --input ../public/openapi.yml --output ./src/adapters/generated.ts"
  },
  "dependencies": {
    "@askrjs/askr": "^0.0.28",
    "@askrjs/askr-themes": "file:./vendor/askr-themes",
    "@askrjs/askr-ui": "file:./vendor/askr-ui",
    "@askrjs/icons-lucide": "file:./vendor/icons-lucide",
    "@fgrzl/fetch": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/ui": "^4.1.0",
    "eslint": "^10.0.3",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}
