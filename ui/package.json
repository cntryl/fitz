{
  "name": "fitz-ui",
  "type": "module",
  "scripts": {
    "clean": "npx rimraf node_modules dist",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "type-check": "tsc --noEmit",
    "lint": "vp lint .",
    "lint:fix": "vp lint src tests --fix",
    "fmt": "vp fmt .",
    "gen": "npm run gen:adapters && npm run fmt",
    "gen:adapters": "npx @fgrzl/fetch-gen --input ../public/openapi.yml --output ./src/adapters/generated/api.ts"
  },
  "dependencies": {
    "@askrjs/askr": "0.0.48",
    "@askrjs/charts": "^0.0.1",
    "@askrjs/logos": "0.0.1",
    "@askrjs/lucide": "^0.0.3",
    "@askrjs/themes": "0.0.10",
    "@askrjs/ui": "0.0.12",
    "@askrjs/vite": "0.0.5",
    "@fgrzl/fetch": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "autoprefixer": "^10.5.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.1"
  },
  "packageManager": "npm@11.17.0"
}
