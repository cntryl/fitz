{
  "name": "fitz-ui",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "type-check": "tsc --noEmit",
    "lint": "vp lint src tests",
    "lint:fix": "vp lint src tests --fix",
    "fmt": "vp fmt src tests README.md --write",
    "gen": "npm run gen:adapters && npm run fmt",
    "gen:adapters": "npx @fgrzl/fetch-gen --input ../public/openapi.yml --output ./src/adapters/generated/api.ts"
  },
  "dependencies": {
    "@askrjs/askr": "0.0.35",
    "@askrjs/lucide": "0.0.1",
    "@askrjs/themes": "^0.0.3",
    "@askrjs/ui": "0.0.6",
    "@askrjs/vite": "0.0.2",
    "@fgrzl/fetch": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "npm@11.14.1"
}
