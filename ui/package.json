{
  "name": "fitz-ui",
  "type": "module",
  "scripts": {
    "clean": "npx rimraf node_modules dist",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "postinstall": "node ./scripts/patch-askr-charts.js",
    "test": "vp test",
    "type-check": "tsc --noEmit",
    "lint": "vp lint .",
    "lint:fix": "vp lint src tests --fix",
    "fmt": "vp fmt .",
    "gen": "npm run gen:adapters && npm run fmt",
    "gen:adapters": "npx @fgrzl/fetch-gen --input ../public/openapi.yml --output ./src/adapters/generated/api.ts"
  },
  "dependencies": {
    "@askrjs/askr": "0.0.37",
    "@askrjs/charts": "^0.0.1",
    "@askrjs/logos": "0.0.1",
    "@askrjs/lucide": "^0.0.2",
    "@askrjs/themes": "^0.0.4",
    "@askrjs/ui": "0.0.7",
    "@askrjs/vite": "0.0.2",
    "@fgrzl/fetch": "^1.4.2"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.22"
  },
  "packageManager": "npm@11.15.0"
}
