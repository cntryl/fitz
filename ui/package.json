{
  "name": "fitz-ui",
  "type": "module",
  "scripts": {
    "clean": "npx rimraf node_modules dist",
    "dev": "vp dev",
    "dev:mock": "VITE_FITZ_MOCK_API=1 vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "check:generated": "askr generate ../public/openapi.yml -o ./src/adapters/generated --check",
    "type-check": "tsc --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "gen": "npm run gen:adapters && npm run fmt",
    "gen:adapters": "askr generate ../public/openapi.yml -o ./src/adapters/generated"
  },
  "dependencies": {
    "@askrjs/askr": "^0.0.84",
    "@askrjs/fetch": "0.0.2",
    "@askrjs/lucide": "0.0.6",
    "@askrjs/themes": "0.0.19",
    "@askrjs/ui": "^0.0.23"
  },
  "devDependencies": {
    "@askrjs/cli": "0.0.17",
    "@askrjs/vite": "0.0.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.7"
  },
  "packageManager": "npm@12.0.2"
}
