{
  "name": "fitz-ui",
  "type": "module",
  "scripts": {
    "clean": "npx rimraf node_modules dist",
    "dev": "vp dev",
    "dev:mock": "VITE_FITZ_MOCK_API=1 vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:preview": "npm run build && PLAYWRIGHT_PREVIEW=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "check:generated": "askr generate ../public/openapi.yml -o ./src/adapters/generated --check",
    "type-check": "tsc --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "gen": "npm run gen:adapters && npm run fmt",
    "gen:adapters": "askr generate ../public/openapi.yml -o ./src/adapters/generated"
  },
  "dependencies": {
    "@askrjs/askr": "^0.2.4",
    "@askrjs/fetch": "0.2.1",
    "@askrjs/lucide": "0.2.1",
    "@askrjs/themes": "^0.2.5",
    "@askrjs/ui": "^0.2.4"
  },
  "devDependencies": {
    "@askrjs/cli": "0.2.3",
    "@askrjs/vite": "0.2.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plus": "^0.2.9"
  },
  "overrides": {
    "@vitest/browser-playwright": "4.1.10",
    "@xmldom/xmldom": "0.9.12"
  },
  "packageManager": "npm@12.0.2",
  "askr": {
    "update": {
      "ignore": [
        "vite-plus"
      ]
    }
  }
}
