{
  "name": "fitz-ui",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "type-check": "tsc --noEmit",
    "lint": "vp lint src tests",
    "lint:fix": "vp lint src tests --fix",
    "fmt": "vp fmt src tests README.md --write",
